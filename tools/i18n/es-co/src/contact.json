 {
  "i": 69,
  "k": "text",
  "en": "Do you offer phone support?"
 },
 {
  "i": 70,
  "k": "text",
  "en": "No phone calls, no hold music. We handle all support by email. This isn't a cost-cutting measure — it's intentional. Email creates a clear record of every request, every response, and every decision. Reputation and Authority plan clients get a 12-hour first-response SLA."
 },
 {
  "i": 71,
  "k": "text",
  "en": "I'm an existing client. How do I reach you?"
 },
 {
  "i": 72,
  "k": "text",
  "en": "Email support@localboostlab.com with your business name in the subject line. Include your GBP URL if your request is profile-specific. We prioritize client emails and respond within 24 hours — usually much faster."
 },
 {
  "i": 73,
  "k": "text",
  "en": "I want to cancel. What do I do?"
 },
 {
  "i": 74,
  "k": "text",
  "en": "Email us at support@localboostlab.com with \"Cancel\" in the subject. We'll deactivate your account within 24 hours. No questions asked, no retention call, no hoops. You own all your GBP data — we won't touch your profile after cancellation."
 },
 {
  "i": 75,
  "k": "text",
  "en": "Can I upgrade or downgrade my plan?"
 },
 {
  "i": 76,
  "k": "text",
  "en": "Yes. Email support@localboostlab.com and we'll process the change at your next billing cycle. Upgrades take effect immediately. There's no fee to change plans and no contract locking you into a tier."
 },
