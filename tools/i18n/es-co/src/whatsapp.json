 {
  "i": 40,
  "k": "text",
  "en": "Give your customers instant answers on WhatsApp, day and night. Local Boost Lab sets up an AI assistant, supervised by our team, that replies to your customers, books appointments and sends reminders, so you never miss a lead or a booking."
 },
 {
  "i": 41,
  "k": "text",
  "en": "Request a demo →"
 },
 {
  "i": 42,
  "k": "text",
  "en": "How it works"
 },
 {
  "i": 43,
  "k": "text",
  "en": "What it does"
 },
 {
  "i": 44,
  "k": "text",
  "en": "Your customers get an answer. You get the booking."
 },
 {
  "i": 45,
  "k": "text",
  "en": "Answers common questions such as address, prices, hours and services."
 },
 {
  "i": 46,
  "k": "text",
  "en": "Schedules appointments and confirms them."
 },
 {
  "i": 47,
  "k": "text",
  "en": "Sends appointment reminders so fewer people miss their visit."
 },
 {
  "i": 48,
  "k": "text",
  "en": "Hands off to your team when a conversation needs a person."
 },
 {
  "i": 49,
  "k": "text",
  "en": "Works on your own WhatsApp Business number, and every conversation stays private to your business."
 },
 {
  "i": 50,
  "k": "text",
  "en": "WhatsApp · Example conversation"
 },
 {
  "i": 51,
  "k": "text",
  "en": "Are you open on Sunday?"
 },
 {
  "i": 52,
  "k": "text",
  "en": "We're closed on Sundays, but Saturday we're open from 9:00 AM to 2:00 PM. Want me to save you a spot?"
 },
 {
  "i": 53,
  "k": "text",
  "en": "Yes, 10 AM please"
 },
 {
  "i": 54,
  "k": "text",
  "en": "Done. You're booked for Saturday at 10:00 AM. We'll send you a reminder on Friday."
 },
 {
  "i": 55,
  "k": "text",
  "en": "✓ Appointment confirmed"
 },
 {
